@model IEnumerable<StudentManagementSystem.Models.Course>

@{
    ViewData["Title"] = "Courses";
}

<h1>Courses</h1>

<p>
    <button type="button"
            class="btn btn-primary"
            onclick="openAddCourseModal()">
        Add Course
    </button>

</p>
   

    <!--Table-->
<div class="course-table-container">
<table class="table table-bordered table-hover">

    <thead>
        <tr>
            <th>
                Course ID
            </th>

            <th>
                Course Name
            </th>

            <th>
                Actions
            </th>
        </tr>
    </thead>

    <tbody>

        @foreach (var course in Model)
        {
            <tr>
                <td>
                    @course.CourseId
                </td>

                <td>
                    @course.CourseName
                </td>

                <td>
                    <button type="button"
                            class="btn btn-sm btn-warning"
                            onclick="openEditCourseModal(@course.CourseId, '@course.CourseName')">
                        Edit
                    </button>

                    |

                    <button type="button"
                            class="btn btn-sm btn-info"
                            onclick="openCourseDetailsModal(@course.CourseId, '@course.CourseName')">
                        Details
                    </button>

                    |

                    <button type="button"
                            class="btn btn-sm btn-danger"
                            onclick="openDeleteCourseModal(@course.CourseId, '@course.CourseName')">
                        Delete
                    </button>
                </td>
            </tr>
        }

    </tbody>

</table>
</div>


<!-- Add Course Modal -->
<div id="addCourseModal" class="course-modal">

    <div class="course-modal-content">

        <div class="course-modal-header">
            <h2>Add Course</h2>

            <button type="button"
                    class="close-button"
                    onclick="closeAddCourseModal()">
                &times;
            </button>
        </div>

        <div class="course-modal-body">

            <label for="courseName">
                Course Name
            </label>

            <input type="text"
                   id="courseName"
                   class="form-control"
                   placeholder="Enter course name" />

        </div>

        <div class="course-modal-footer">

            <button type="button"
                    class="btn btn-secondary"
                    onclick="closeAddCourseModal()">
                Cancel
            </button>

            <button type="button"
                    class="btn btn-primary"
                    onclick="addCourse()">
                Save
            </button>

        </div>

    </div>

</div>




<!-- Edit Course Modal -->
<div id="editCourseModal" class="course-modal">

    <div class="course-modal-content">

        <div class="course-modal-header">
            <h2>Edit Course</h2>

            <button type="button"
                    class="close-button"
                    onclick="closeEditCourseModal()">
                &times;
            </button>
        </div>

        <div class="course-modal-body">

            <input type="hidden" id="editCourseId" />

            <label for="editCourseName">
                Course Name
            </label>

            <input type="text"
                   id="editCourseName"
                   class="form-control" />

        </div>

        <div class="course-modal-footer">

            <button type="button"
                    class="btn btn-secondary"
                    onclick="closeEditCourseModal()">
                Cancel
            </button>

            <button type="button"
                    class="btn btn-primary"
                    onclick="updateCourse()">
                Save Changes
            </button>

        </div>

    </div>

</div>


<!-- Course Details Modal -->
<div id="courseDetailsModal" class="course-modal">

    <div class="course-modal-content">

        <div class="course-modal-header">

            <h2>Course Details</h2>

            <button type="button"
                    class="close-button"
                    onclick="closeCourseDetailsModal()">
                &times;
            </button>

        </div>

        <div class="course-modal-body">

            <p>
                <strong>Course ID:</strong>
                <span id="detailsCourseId"></span>
            </p>

            <p>
                <strong>Course Name:</strong>
                <span id="detailsCourseName"></span>
            </p>

        </div>

        <div class="course-modal-footer">

            <button type="button"
                    class="btn btn-secondary"
                    onclick="closeCourseDetailsModal()">
                Close
            </button>

        </div>

    </div>

</div>




<!-- Delete Course Modal -->
<div id="deleteCourseModal" class="course-modal">

    <div class="course-modal-content">

        <div class="course-modal-header">

            <h2>Delete Course</h2>

            <button type="button"
                    class="close-button"
                    onclick="closeDeleteCourseModal()">
                &times;
            </button>

        </div>

        <div class="course-modal-body">

            <input type="hidden" id="deleteCourseId" />

            <p>
                Are you sure you want to delete
                <strong id="deleteCourseName"></strong>?
            </p>

        </div>

        <div class="course-modal-footer">

            <button type="button"
                    class="btn btn-secondary"
                    onclick="closeDeleteCourseModal()">
                Cancel
            </button>

            <button type="button"
                    class="btn btn-danger"
                    onclick="deleteCourse()">
                Delete
            </button>

        </div>

    </div>

</div>