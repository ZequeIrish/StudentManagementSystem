@model IEnumerable<StudentManagementSystem.Models.Student>

@{
    ViewData["Title"] = "Index";
}

<h1>Students</h1>

<div class="summary-cards">

    <div class="summary-card">
        <strong>Average Age</strong>
        <span>@ViewBag.AverageAge</span>
    </div>

</div>

<!-- button for viewing department summary -->
<div class="mb-3">
    <button type="button"
            class="btn btn-primary"
            onclick="openDepartmentSummary()">
        View Department Summary
    </button>
</div>

<!-- search -->
<form asp-action="Index" method="get">
    <input type="text"
           name="searchString"
           value="@Context.Request.Query["searchString"]"
           placeholder="Search student..." />

    <button type="submit">Search</button>

    <a asp-action="Index">Clear</a>
</form>

<p>
    Sort:
    <a asp-action="Index" asp-route-sortOrder="">A-Z</a> |
    <a asp-action="Index" asp-route-sortOrder="name_desc">Z-A</a>
</p>

<p>
    <a asp-action="Create" class="btn btn-primary">
        Add Students
    </a>
</p>

<div class="student-table-container">
    <table class="table table-bordered table-hover">
    <thead>
        <tr>
            <th>
                <a asp-action="Index"
                   asp-route-sortOrder="first_name"
                   asp-route-searchString="@Context.Request.Query["searchString"]">
                    First Name
                </a>
            </th>

            <th>
                Middle Name
            </th>
            <th>
                <a asp-action="Index"
                   asp-route-sortOrder="last_name"
                   asp-route-searchString="@Context.Request.Query["searchString"]">
                    Last Name
                </a>
            </th>
           
            <th>
                @Html.DisplayNameFor(model => model.Age)
            </th>
            <th>
                <a asp-action="Index"
                   asp-route-sortOrder="course"
                   asp-route-searchString="@Context.Request.Query["searchString"]">
                    Course
                </a>
            </th>
            
            <th>
                @Html.DisplayNameFor(model => model.Address)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DepartmentId)
            </th>
            <th>
                <a asp-action="Index"
                   asp-route-sortOrder="department"
                   asp-route-searchString="@Context.Request.Query["searchString"]">
                    Department
                </a>
            </th>
           
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.FirstName)
            </td>
            <td>
                @Html.DisplayFor(model => item.MiddleName)
            </td>
            <td>
                @Html.DisplayFor(model => item.LastName)
            </td>
            <td>
                @Html.DisplayFor(model => item.Age)
            </td>
            <td>
                @Html.DisplayFor(model => item.Course)
            </td>
            <td>
                @Html.DisplayFor(model => item.Address)
            </td>
            <td>
                @Html.DisplayFor(model => item.DepartmentId)
            </td>
            <td>
                    @Html.DisplayFor(modelItem => item.Department.DepartmentName)
            </td>
                    <td>
                        <a asp-action="Edit"
                           asp-route-id="@item.StudentId"
                           class="btn btn-sm btn-warning">
                            Edit
                        </a>

                        |

                        <a asp-action="Details"
                           asp-route-id="@item.StudentId"
                           class="btn btn-sm btn-info">
                            Details
                        </a>

                        |

                        <a asp-action="Delete"
                           asp-route-id="@item.StudentId"
                           class="btn btn-sm btn-danger">
                            Delete
                        </a>
                    </td>
        </tr>
        }
        
    </tbody>
    
</table>
</div>

<!-- Department Summary Modal-->
<div id="departmentSummaryModal"
     class="department-modal"
     style="display: none;">

    <div class="department-modal-content">

        <div class="department-modal-header">
            <h3>Department Summary</h3>

            <button type="button"
                    class="close-button"
                    onclick="closeDepartmentSummary()">
                &times;
            </button>
        </div>

        <div class="department-list">

            @foreach (var department in ViewBag.DepartmentSummary)
            {
                <div class="department-item">

                    <div class="department-info">
                        <strong>@department.DepartmentName</strong>

                        <span>
                            @department.StudentCount student(s)
                        </span>
                    </div>

                    <button type="button"
                            class="btn btn-sm btn-primary"
                            onclick="viewDepartment(@department.DepartmentId, '@department.DepartmentName')">
                        >
                        View
                    </button>

                </div>
            }

        </div>

    </div>
</div>

<!-- Department Students Modal -->
<div id="departmentStudentsModal"
     class="department-students-modal"
     style="display: none;">

    <div class="department-students-content">

        <div class="department-students-header">

            <h2 id="departmentStudentsTitle">
                Students
            </h2>

            <button type="button"
                    class="close-button"
                    onclick="closeDepartmentStudents()">
                &times;
            </button>

        </div>

        <div id="departmentStudentsTable">

            <div class="department-student-table-container">

                <table class="table table-bordered table-hover">

                    <thead>
                        <tr>
                            <th>First Name</th>
                            <th>Middle Name</th>
                            <th>Last Name</th>
                            <th>Age</th>
                            <th>Course</th>
                            <th>Address</th>
                            <th>Department</th>
                        </tr>
                    </thead>

                    <tbody id="departmentStudentsTableBody">
                        <!-- Students will be loaded here -->
                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>

<style>
    <!-- table index -->
    html,
    body {
        height: 100%;
        overflow: hidden;
    }

    .student-table-container {
        height: 400px;
        overflow-y: auto;
        overflow-x: auto;
        position: relative;
        border: 1px solid #ddd;
    }

        .student-table-container table {
            margin-bottom: 0;
        }

        .student-table-container thead th {
            position: sticky;
            top: 0;
            background-color: white;
            z-index: 1;
        }
   




    /* Department Summary Modal */
    .department-modal {
        display: none;
        position: fixed;
        inset: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.5);
        z-index: 999999;
    }

    /* Department Summary Container */
    .department-modal-content {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 380px;
        max-height: 75vh;
        background-color: white;
        border-radius: 10px;
        padding: 20px;
        box-shadow: 0 5px 25px rgba(0, 0, 0, 0.3);
        overflow-y: auto;
    }

    /* Department Summary Header */
    .department-modal-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 15px;
    }

        .department-modal-header h3 {
            margin: 0;
        }


    /* Close Button */
    .close-button {
        border: none;
        background: none;
        font-size: 30px;
        cursor: pointer;
        line-height: 1;
    }

        .close-button:hover {
            color: red;
        }


    /* Each Department */
    .department-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 12px;
        margin-bottom: 10px;
        border: 1px solid #ddd;
        border-radius: 6px;
    }

        .department-item span {
            display: block;
            font-size: 14px;
            color: #666;
            margin-top: 3px;
        }

    .department-info {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }


    .department-list {
        max-height: 400px;
        overflow-y: auto;
        padding-right: 5px;
    }
 




    /* Department Students Modal */
    .department-student-table-container {
        max-height: 400px;
        overflow-y: auto;
        overflow-x: auto;
        position: relative;
    }

        /* Keep column headers visible while scrolling */
        .department-student-table-container thead th {
            position: sticky;
            top: 0;
            background-color: white;
            z-index: 1;
        }
    .department-students-modal {
        display: none;
        position: fixed;
        inset: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.5);
        z-index: 999999;
    }

    /* Large Landscape Container */
    .department-students-content {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 90%;
        max-width: 1200px;
        max-height: 80vh;
        background-color: white;
        border-radius: 10px;
        padding: 20px;
        box-shadow: 0 5px 25px rgba(0, 0, 0, 0.3);
        overflow: hidden;
    }

    /* Header */
    .department-students-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 15px;
    }

        .department-students-header h2 {
            margin: 0;
        }

        /* Close Button */
        .department-students-header .close-button {
            border: none;
            background: none;
            font-size: 30px;
            cursor: pointer;
            line-height: 1;
        }

        .department-students-header .close-button:hover {
                color: red;
            }

        .department-student-empty {
        text-align: center;
        padding: 30px;
        color: #777;
        font-size: 16px;
    }


    /*Summary Cards*/
    .summary-cards {
        display: flex;
        gap: 20px;
        margin-bottom: 25px;
    }

    
</style>

<script>

    /*department modal*/ 
    function openDepartmentSummary() {
        document.getElementById("departmentSummaryModal").style.display = "block";
    }

    function closeDepartmentSummary() {
        document.getElementById("departmentSummaryModal").style.display = "none";
    }





     /* Student modal */
    async function viewDepartment(departmentId, departmentName) {

        // Close Department Summary
        document.getElementById("departmentSummaryModal").style.display = "none";

        // Set modal title
        document.getElementById("departmentStudentsTitle").innerText =
            departmentName + " Students";

        // Open Student Modal
        document.getElementById("departmentStudentsModal").style.display = "block";

        // Get the table body
        const tableBody =
            document.getElementById("departmentStudentsTableBody");

        // Show loading message
        tableBody.innerHTML = `
            <tr>
                <td colspan="7">Loading students...</td>
            </tr>
        `;

        try {

            const response = await fetch(
                `/Students/DepartmentStudents/${departmentId}`
            );

            const students = await response.json();

            tableBody.innerHTML = "";

            if (students.length === 0) {

                tableBody.innerHTML = `
                    <tr>
                           <td colspan="7" class="department-student-empty">
                                No students found in this department.
                           </td>
                    </tr>
                `;

                return;
            }

            students.forEach(student => {

                const row = `
                    <tr>
                        <td>${student.firstName ?? ""}</td>
                        <td>${student.middleName ?? ""}</td>
                        <td>${student.lastName ?? ""}</td>
                        <td>${student.age ?? ""}</td>
                        <td>${student.course ?? ""}</td>
                        <td>${student.address ?? ""}</td>
                        <td>${student.department ?? ""}</td>
                    </tr>
                `;

                tableBody.innerHTML += row;
            });

        } catch (error) {

            console.error(error);

            tableBody.innerHTML = `
                <tr>
                       <td colspan="7" class="department-student-empty">
                            Error loading students.
                       </td>
                </tr>
            `;
        }
    }

    function closeDepartmentStudents() {

        document.getElementById("departmentStudentsModal").style.display =
            "none";
    }
</script>
