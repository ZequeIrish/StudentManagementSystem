@model IEnumerable<StudentManagementSystem.Models.Student>

@{
    ViewData["Title"] = "Students";

    // What the user is searching and sorting by right now (empty = nothing / default).
    var currentSearch = Context.Request.Query["searchString"].ToString();
    var currentSort = Context.Request.Query["sortOrder"].ToString();

    // Default sort (empty) is Last Name A-Z.
    var isLastNameAscending = currentSort == "" || currentSort == "last_name";

    // Small arrow next to the column that is being sorted.
    string SortArrow(string sortKey) =>
        (sortKey == "last_name" && isLastNameAscending) || (sortKey != "last_name" && currentSort == sortKey) ? " ▲"
        : (sortKey == "last_name" && currentSort == "name_desc") ? " ▼"
        : "";
}

<!-- title + average age on the left, main buttons on the right -->
<div class="sms-page-header">

    <div class="sms-page-title">
        <h1>Students</h1>
        <span class="sms-stat-pill">Average Age: <strong>@ViewBag.AverageAge</strong></span>
    </div>

    <div class="sms-page-buttons">
        <button type="button"
                class="btn btn-outline-secondary"
                onclick="openDepartmentSummary()">
            <i class="bi bi-bar-chart"></i> Department Summary
        </button>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> Add Student
        </a>
    </div>

</div>

<!-- search + sort -->
<div class="sms-toolbar">

    <form asp-action="Index" method="get" class="sms-search">
        <!-- keep the current sort when searching -->
        <input type="hidden" name="sortOrder" value="@currentSort" />

        <div class="input-group">
            <span class="input-group-text"><i class="bi bi-search"></i></span>
            <input type="text"
                   name="searchString"
                   value="@currentSearch"
                   class="form-control"
                   placeholder="Search name, course, address, department or age"
                   aria-label="Search students" />
            <button type="submit" class="btn btn-primary">Search</button>
            <a asp-action="Index" class="btn btn-secondary">Clear</a>
        </div>
    </form>

    <div class="sms-sort">
        <span class="sms-sort-label">Sort by last name:</span>
        <div class="btn-group btn-group-sm" role="group" aria-label="Sort by last name">
            <!-- keep the current search when sorting -->
            <a asp-action="Index"
               asp-route-sortOrder=""
               asp-route-searchString="@currentSearch"
               class="btn @(isLastNameAscending ? "btn-primary" : "btn-outline-secondary")">A–Z</a>
            <a asp-action="Index"
               asp-route-sortOrder="name_desc"
               asp-route-searchString="@currentSearch"
               class="btn @(currentSort == "name_desc" ? "btn-primary" : "btn-outline-secondary")">Z–A</a>
        </div>
    </div>

</div>

<div class="student-table-container">
    <table class="table table-bordered table-hover">
    <thead>
        <tr>
            <th>
                <a asp-action="Index"
                   asp-route-sortOrder="first_name"
                   asp-route-searchString="@currentSearch">
                    First Name@(SortArrow("first_name"))
                </a>
            </th>

            <th>
                Middle Name
            </th>
            <th>
                <a asp-action="Index"
                   asp-route-sortOrder="last_name"
                   asp-route-searchString="@currentSearch">
                    Last Name@(SortArrow("last_name"))
                </a>
            </th>
           
            <th>
                @Html.DisplayNameFor(model => model.Age)
            </th>
            <th>
                <a asp-action="Index"
                   asp-route-sortOrder="course"
                   asp-route-searchString="@currentSearch">
                    Course@(SortArrow("course"))
                </a>
            </th>
            
            <th>
                @Html.DisplayNameFor(model => model.Address)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DepartmentId)
            </th>
            <th>
                <a asp-action="Index"
                   asp-route-sortOrder="department"
                   asp-route-searchString="@currentSearch">
                    Department@(SortArrow("department"))
                </a>
            </th>
            <th>
                Actions
            </th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.FirstName)
            </td>
            <td>
                @Html.DisplayFor(model => item.MiddleName)
            </td>
            <td>
                @Html.DisplayFor(model => item.LastName)
            </td>
            <td>
                @Html.DisplayFor(model => item.Age)
            </td>
            <td>
                @Html.DisplayFor(model => item.Course)
            </td>
            <td>
                @Html.DisplayFor(model => item.Address)
            </td>
            <td>
                @Html.DisplayFor(model => item.DepartmentId)
            </td>
            <td>
                    @Html.DisplayFor(modelItem => item.Department.DepartmentName)
            </td>
            <td>
                <div class="sms-actions">
                    <a asp-action="Edit"
                       asp-route-id="@item.StudentId"
                       class="btn btn-sm btn-warning">
                        Edit
                    </a>
                    <a asp-action="Details"
                       asp-route-id="@item.StudentId"
                       class="btn btn-sm btn-info">
                        Details
                    </a>
                    <a asp-action="Delete"
                       asp-route-id="@item.StudentId"
                       class="btn btn-sm btn-danger">
                        Delete
                    </a>
                </div>
            </td>
        </tr>
        }
        
    </tbody>
    
</table>
</div>

<!-- Department Summary Modal-->
<div id="departmentSummaryModal"
     class="department-modal"
     style="display: none;">

    <div class="department-modal-content">

        <div class="department-modal-header">
            <h3>Department Summary</h3>

            <button type="button"
                    class="close-button"
                    onclick="closeDepartmentSummary()">
                &times;
            </button>
        </div>

        <div class="department-list">

            @foreach (var department in ViewBag.DepartmentSummary)
            {
                <div class="department-item">

                    <div class="department-info">
                        <strong>@department.DepartmentName</strong>

                        <span>
                            @department.StudentCount student(s)
                        </span>
                    </div>

                    <button type="button"
                            class="btn btn-sm btn-primary"
                            data-department-id="@department.DepartmentId"
                            data-department-name="@department.DepartmentName"
                            onclick="viewDepartment(this.dataset.departmentId, this.dataset.departmentName)">
                        View
                    </button>

                </div>
            }

        </div>

    </div>
</div>

<!-- Department Students Modal -->
<div id="departmentStudentsModal"
     class="department-students-modal"
     style="display: none;">

    <div class="department-students-content">

        <div class="department-students-header">

            <h2 id="departmentStudentsTitle">
                Students
            </h2>

            <button type="button"
                    class="close-button"
                    onclick="closeDepartmentStudents()">
                &times;
            </button>

        </div>

        <div id="departmentStudentsTable">

            <div class="department-student-table-container">

                <table class="table table-bordered table-hover">

                    <thead>
                        <tr>
                            <th>First Name</th>
                            <th>Middle Name</th>
                            <th>Last Name</th>
                            <th>Age</th>
                            <th>Course</th>
                            <th>Address</th>
                            <th>Department</th>
                        </tr>
                    </thead>

                    <tbody id="departmentStudentsTableBody">
                        <!-- Students will be loaded here -->
                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>

<style>
    <!-- table index -->
    html,
    body {
        height: 100%;
        overflow: hidden;
    }

    .student-table-container {
        height: 400px;
        overflow-y: auto;
        overflow-x: auto;
        position: relative;
        border: 1px solid #ddd;
    }

        .student-table-container table {
            margin-bottom: 0;
        }

        .student-table-container thead th {
            position: sticky;
            top: 0;
            background-color: white;
            z-index: 1;
        }
   




    /* Department Summary Modal */
    .department-modal {
        display: none;
        position: fixed;
        inset: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.5);
        z-index: 999999;
    }

    /* Department Summary Container */
    .department-modal-content {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 380px;
        max-height: 75vh;
        background-color: white;
        border-radius: 10px;
        padding: 20px;
        box-shadow: 0 5px 25px rgba(0, 0, 0, 0.3);
        overflow-y: auto;
    }

    /* Department Summary Header */
    .department-modal-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 15px;
    }

        .department-modal-header h3 {
            margin: 0;
        }


    /* Close Button */
    .close-button {
        border: none;
        background: none;
        font-size: 30px;
        cursor: pointer;
        line-height: 1;
    }

        .close-button:hover {
            color: red;
        }


    /* Each Department */
    .department-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 12px;
        margin-bottom: 10px;
        border: 1px solid #ddd;
        border-radius: 6px;
    }

        .department-item span {
            display: block;
            font-size: 14px;
            color: #666;
            margin-top: 3px;
        }

    .department-info {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }


    .department-list {
        max-height: 400px;
        overflow-y: auto;
        padding-right: 5px;
    }
 




    /* Department Students Modal */
    .department-student-table-container {
        max-height: 400px;
        overflow-y: auto;
        overflow-x: auto;
        position: relative;
    }

        /* Keep column headers visible while scrolling */
        .department-student-table-container thead th {
            position: sticky;
            top: 0;
            background-color: white;
            z-index: 1;
        }
    .department-students-modal {
        display: none;
        position: fixed;
        inset: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.5);
        z-index: 999999;
    }

    /* Large Landscape Container */
    .department-students-content {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 90%;
        max-width: 1200px;
        max-height: 80vh;
        background-color: white;
        border-radius: 10px;
        padding: 20px;
        box-shadow: 0 5px 25px rgba(0, 0, 0, 0.3);
        overflow: hidden;
    }

    /* Header */
    .department-students-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 15px;
    }

        .department-students-header h2 {
            margin: 0;
        }

        /* Close Button */
        .department-students-header .close-button {
            border: none;
            background: none;
            font-size: 30px;
            cursor: pointer;
            line-height: 1;
        }

        .department-students-header .close-button:hover {
                color: red;
            }

        .department-student-empty {
        text-align: center;
        padding: 30px;
        color: #777;
        font-size: 16px;
    }


    /*Summary Cards*/
    .summary-cards {
        display: flex;
        gap: 20px;
        margin-bottom: 25px;
    }

    
</style>

<script>

    /*department modal*/ 
    function openDepartmentSummary() {
        document.getElementById("departmentSummaryModal").style.display = "block";
    }

    function closeDepartmentSummary() {
        document.getElementById("departmentSummaryModal").style.display = "none";
    }





     /* Student modal */

    // Shows one message row (Loading / No students / Error) across the whole table.
    function showDepartmentMessage(tableBody, message) {
        const row = document.createElement("tr");
        const cell = document.createElement("td");
        cell.colSpan = 7;
        cell.className = "department-student-empty";
        cell.textContent = message;
        row.appendChild(cell);
        tableBody.replaceChildren(row);
    }

    async function viewDepartment(departmentId, departmentName) {

        // Close Department Summary, set the title, open the Students popup
        document.getElementById("departmentSummaryModal").style.display = "none";
        document.getElementById("departmentStudentsTitle").textContent = departmentName + " Students";
        document.getElementById("departmentStudentsModal").style.display = "block";

        const tableBody = document.getElementById("departmentStudentsTableBody");
        showDepartmentMessage(tableBody, "Loading students...");

        try {
            const response = await fetch(`/Students/DepartmentStudents/${departmentId}`);

            if (!response.ok) {
                throw new Error("Server answered with status " + response.status);
            }

            const students = await response.json();

            if (students.length === 0) {
                showDepartmentMessage(tableBody, "No students found in this department.");
                return;
            }

            tableBody.replaceChildren();   // empty the table

            students.forEach(student => {
                const row = document.createElement("tr");

                const values = [
                    student.firstName, student.middleName, student.lastName,
                    student.age, student.course, student.address, student.department
                ];

                values.forEach(value => {
                    const cell = document.createElement("td");
                    cell.textContent = value ?? "";   // plain text only, never run as code
                    row.appendChild(cell);
                });

                tableBody.appendChild(row);
            });

        } catch (error) {
            console.error(error);
            showDepartmentMessage(tableBody, "Error loading students.");
        }
    }

    function closeDepartmentStudents() {

        document.getElementById("departmentStudentsModal").style.display =
            "none";
    }
</script>
