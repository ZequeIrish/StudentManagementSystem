@model IEnumerable<StudentManagementSystem.Models.Department>

@{
    ViewData["Title"] = "Departments";
}

<!-- title on the left, Add button on the right -->
<div class="sms-page-header">
    <div class="sms-page-title">
        <h1>Departments</h1>
    </div>
    <div class="sms-page-buttons">
        <button type="button"
                class="btn btn-primary"
                onclick="openAddDepartmentModal()">
            <i class="bi bi-plus-lg"></i> Add Department
        </button>
    </div>
</div>

<div class="department-table-container">

    <table class="table table-bordered table-hover">

        <thead>
            <tr>
				<th>Department ID</th>
				<th>Department Name</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>

            @foreach (var department in Model)
            {
                <tr>
                    <td>
                        @department.DepartmentId
                    </td>

                    <td>
                        @department.DepartmentName
                    </td>

                    <td>
                        <div class="sms-actions">
                            <button type="button"
                                    class="btn btn-sm btn-warning"
                                    data-department-id="@department.DepartmentId"
                                    data-department-name="@department.DepartmentName"
                                    onclick="openEditDepartmentModal(this.dataset.departmentId, this.dataset.departmentName)">
                                Edit
                            </button>
                            <button type="button"
                                    class="btn btn-sm btn-info"
                                    data-department-id="@department.DepartmentId"
                                    data-department-name="@department.DepartmentName"
                                    onclick="openDepartmentDetailsModal(this.dataset.departmentId, this.dataset.departmentName)">
                                Details
                            </button>
                            <button type="button"
                                    class="btn btn-sm btn-danger"
                                    data-department-id="@department.DepartmentId"
                                    data-department-name="@department.DepartmentName"
                                    onclick="openDeleteDepartmentModal(this.dataset.departmentId, this.dataset.departmentName)">
                                Delete
                            </button>
                        </div>
                    </td>
                </tr>
            }

        </tbody>

    </table>

</div>



<!-- Add Department Modal -->
<div id="addDepartmentModal" class="department-modal">

    <div class="department-modal-content">

        <div class="department-modal-header">
            <h2>Add Department</h2>

            <button type="button"
                    class="close-button"
                    onclick="closeAddDepartmentModal()">
                &times;
            </button>
        </div>

        <div class="department-modal-body">

            <label for="departmentName">
                Department Name
            </label>

            <input type="text"
                   id="departmentName"
                   class="form-control"
                   placeholder="Enter department name" />

        </div>

        <div class="department-modal-footer">

            <button type="button"
                    class="btn btn-secondary"
                    onclick="closeAddDepartmentModal()">
                Cancel
            </button>

            <button type="button"
                    class="btn btn-primary"
                    onclick="addDepartment()">
                Save
            </button>

        </div>

    </div>

</div>




<!-- Edit Department Modal -->
<div id="editDepartmentModal" class="department-modal">

    <div class="department-modal-content">

        <div class="department-modal-header">
            <h2>Edit Department</h2>

            <button type="button"
                    class="close-button"
                    onclick="closeEditDepartmentModal()">
                &times;
            </button>
        </div>

        <div class="department-modal-body">

            <input type="hidden" id="editDepartmentId" />

            <label for="editDepartmentName">
                Department Name
            </label>

            <input type="text"
                   id="editDepartmentName"
                   class="form-control" />

        </div>

        <div class="department-modal-footer">

            <button type="button"
                    class="btn btn-secondary"
                    onclick="closeEditDepartmentModal()">
                Cancel
            </button>

            <button type="button"
                    class="btn btn-primary"
                    onclick="updateDepartment()">
                Save Changes
            </button>

        </div>

    </div>

</div>


<!-- Department Details Modal -->
<div id="departmentDetailsModal" class="department-modal">

    <div class="department-modal-content">

        <div class="department-modal-header">

            <h2>Department Details</h2>

            <button type="button"
                    class="close-button"
                    onclick="closeDepartmentDetailsModal()">
                &times;
            </button>

        </div>

        

        <div class="department-modal-body">

            <p>
                <strong>Department ID:</strong>
                <span id="detailsDepartmentId"></span>
            </p>

            <p>
                <strong>Department Name:</strong>
                <span id="detailsDepartmentName"></span>
            </p>
        </div>

        <div class="department-modal-footer">

            <button type="button"
                    class="btn btn-secondary"
                    onclick="closeDepartmentDetailsModal()">
                Close
            </button>

        </div>

    </div>

</div>




<!-- Delete Department Modal -->
<div id="deleteDepartmentModal" class="department-modal">

    <div class="department-modal-content">

        <div class="department-modal-header">

            <h2>Delete Department</h2>

            <button type="button"
                    class="close-button"
                    onclick="closeDeleteDepartmentModal()">
                &times;
            </button>

        </div>

        <div class="department-modal-body">

            <input type="hidden" id="deleteDepartmentId" />

            <p>
                Are you sure you want to delete
                <strong id="deleteDepartmentName"></strong>?
            </p>

        </div>

        <div class="department-modal-footer">

            <button type="button"
                    class="btn btn-secondary"
                    onclick="closeDeleteDepartmentModal()">
                Cancel
            </button>

            <button type="button"
                    class="btn btn-danger"
                    onclick="deleteDepartment()">
                Delete
            </button>

        </div>

    </div>

</div>

